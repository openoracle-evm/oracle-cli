{
  "name": "@openoracle/cli",
  "version": "0.1.0",
  "description": "Open Oracle in your terminal: stock prices from Pyth, market hours, tokenized-stock premium and StockGuardHook fee quotes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "oracle": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openoracle/sdk": "github:openoracle-evm/oracle-sdk"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.57.4",
    "vitest": "^5.0.3"
  }
}
